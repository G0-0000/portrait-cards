{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "column",
  "children": [
    {
      "id": "brand",
      "type": "block",
      "content": {
        "mod": "workspace-chrome"
      },
      "size": {
        "px": 46
      },
      "window_drag": true
    },
    {
      "id": "spaces-panel",
      "type": "row",
      "children": [
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces-cards"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        }
      ],
      "size": {
        "px": 110
      },
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "agents-panel",
      "type": "row",
      "children": [
        {
          "id": "agents",
          "type": "block",
          "content": {
            "mod": "agents-cards"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        }
      ],
      "size": {
        "px": 110
      },
      "background": "chrome",
      "resizable": false
    }
  ],
  "font": "Sarasa Mono SC XLight",
  "font_size": 18,
  "ui_font": "JetBrains Mono",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 0,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "ghostty-mocha"
}
